#!/bin/sh
# rc.vmbuilder:  start vmbuilder
#

export VMB_HOME=/var/cache/vmbuilder
export VMBUILDER_ID

vmbuilder_start() {
  if [ -x $VMB_HOME/vmbuilder ]; then
    echo "XXXXX Running vmbuilder at $(date) XXXXX" 2>&1 |tee $VMB_HOME/op.vmbuilder
    $VMB_HOME/vmbuilder 2>&1 |tee -a $VMB_HOME/op.vmbuilder
  fi
}

vmbuilder_stop() {
  echo "The \"stop\" feature is not currently supported"
}

vmbuilder_restart() {
  echo "The \"restart\" feature is not currently supported"
}

case "$1" in
'start')
  vmbuilder_start
  ;;
'stop')
  vmbuilder_stop
  ;;
'restart')
  vmbuilder_restart
  ;;
*)
  vmbuilder_start
esac
